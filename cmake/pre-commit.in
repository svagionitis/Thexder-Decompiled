#!/bin/sh
# ==============================================================================
# Git Pre-Commit Hook: Clang-Format Code Style Verification
# Auto-generated by CMake for Thexder-Decompiled
# ==============================================================================

# Find all staged C and C++ source/header files (Added, Copied, Modified, Renamed)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(c|h|cpp|hpp|cc|cxx)$')

# If no relevant files are staged, exit immediately
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "================================================================================"
echo " [Git Hook] Checking clang-format compliance on staged C/C++ files..."
echo "================================================================================"

# Identify Python interpreter
PYTHON_BIN="@Python3_EXECUTABLE@"

# Fallback detection if configured Python is missing or invalid
if [ ! -f "$PYTHON_BIN" ] && [ ! -x "$PYTHON_BIN" ] && ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    if command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="python3"
    elif command -v python >/dev/null 2>&1; then
        PYTHON_BIN="python"
    elif command -v py >/dev/null 2>&1; then
        PYTHON_BIN="py -3"
    else
        echo "[Git Hook] WARNING: Python interpreter not found in PATH. Skipping style check."
        exit 0
    fi
fi

# Locate verify_clang_format.py script (relative to repo root, or absolute CMake fallback)
SCRIPT_PATH="scripts/verify_clang_format.py"
if [ ! -f "$SCRIPT_PATH" ]; then
    SCRIPT_PATH="@CMAKE_CURRENT_SOURCE_DIR@/scripts/verify_clang_format.py"
fi

if [ ! -f "$SCRIPT_PATH" ]; then
    echo "[Git Hook] ERROR: Could not locate scripts/verify_clang_format.py!"
    exit 1
fi

# Execute verify_clang_format.py on staged files only
"$PYTHON_BIN" "$SCRIPT_PATH" --files $STAGED_FILES
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "================================================================================"
    echo " [Git Hook] COMMIT REJECTED: Code style violations detected by clang-format!"
    echo "--------------------------------------------------------------------------------"
    echo " To automatically fix the formatting on these files, execute:"
    echo "   cmake --build build --target format"
    echo " or:"
    echo "   python scripts/verify_clang_format.py --fix --files $STAGED_FILES"
    echo ""
    echo " After fixing, stage the changes ('git add ...') and retry commit."
    echo "================================================================================"
    exit 1
fi

echo "[Git Hook] All staged files comply with clang-format."
exit 0

